{
  "rewrites": [
    { "source": "/auth/:path*",     "destination": "https://aaharya-api-staging.onrender.com/auth/:path*" },
    { "source": "/meals/:path*",    "destination": "https://aaharya-api-staging.onrender.com/meals/:path*" },
    { "source": "/settings/:path*", "destination": "https://aaharya-api-staging.onrender.com/settings/:path*" },
    { "source": "/health",          "destination": "https://aaharya-api-staging.onrender.com/health" },
    { "source": "/(.*)",            "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
